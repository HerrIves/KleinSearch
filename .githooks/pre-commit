#!/bin/sh
# Git pre-commit hook to block Telegram Bot Tokens

# Regex for Telegram Bot Token (e.g. 1234567890:ABCdef123...)
PATTERN="[0-9]{9,10}:[a-zA-Z0-9_-]{35}"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FOUND=0

for FILE in $STAGED_FILES; do
    if grep -qE "$PATTERN" "$FILE"; then
        echo "=========================================================================="
        echo "🚨 CRITICAL SECURITY ERROR 🚨"
        echo "A potential Telegram Bot Token was detected in: $FILE"
        echo "Commit is blocked. Please replace the token with a placeholder and retry."
        echo "=========================================================================="
        FOUND=1
    fi
done

if [ $FOUND -eq 1 ]; then
    exit 1
fi

exit 0
